# Copy to .env and fill in. Never commit .env.

# LLM backend: openai_compat | none
#   none          no model: deterministic quote finding and fixed template explanations
#   openai_compat any OpenAI-compatible /chat/completions endpoint
LLM_BACKEND=none
LLM_BASE_URL=
LLM_API_KEY=
# Pin an exact model name (no "latest" aliases) so results are reproducible.
LLM_MODEL=

# Path to the SQLite database built by scripts/ingest.py
DB_PATH=data/db/tabayyanu.sqlite

# Show draft learning paths (team preview only; never on the public demo)
SHOW_DRAFT_PATHS=0
